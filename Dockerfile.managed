FROM golang:1.24-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /tp-plugin-http ./cmd

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /tp-plugin-http /app/tp-plugin-http
COPY configs/managed.yaml /app/config/config.yaml
USER 65534:65534
ENTRYPOINT ["/app/tp-plugin-http", "-c", "/app/config/config.yaml"]
